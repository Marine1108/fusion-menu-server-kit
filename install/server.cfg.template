## ============================================================================
##  Fusion Menu - server configuration (generated by the installer)
##
##  You should never need to edit this file. Server name, whitelist, maintenance,
##  permissions and every feature are configured in game (F10 or /admin).
##  OneSync must be enabled (txAdmin: Settings > FXServer).
## ============================================================================

{{serverEndpoints}}
sv_maxclients {{maxClients}}
sv_enforceGameBuild 3095
set steam_webApiKey "none"
sv_licenseKey "{{svLicense}}"

## Name shown until the server has started (afterwards: Admin > Settings > Server)
sv_hostname "{{serverName}}"
sets sv_projectName "{{serverName}}"
sets sv_projectDesc "Powered by Fusion Menu"
sets tags "fusion, vmenu, qbcore, roleplay"
sets locale "en-US"
sv_scriptHookAllowed 0

## Database
set mysql_connection_string "{{dbConnectionString}}"

## Owners. Anyone in group.admin is a Fusion owner. If nobody is listed, the
## server console prints a one-time code: join and type /claimowner <code>.
add_ace group.admin fusion.owner allow
{{addPrincipalsMaster}}

## Lets Fusion mirror in-game permissions to ACE and manage resources
add_ace resource.fusion-core command allow
## Lets the carcols fixer and handling editor edit vehicle packs (file kept up to date by Fusion)
exec resources/[fusion]/fusion-core/permissions/filesystem.cfg

## Default Cfx resources
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager
ensure hardcap
ensure baseevents
ensure rconlog

## Fusion framework (order matters)
ensure oxmysql
ensure fmenu-check
ensure fusion-updater
ensure fusion-core
ensure fusion-anticheat
ensure qb-core
ensure qb-menu
ensure qb-input
ensure progressbar
ensure fusion-loadscreen
ensure fusion-target
ensure fusion-inventory
ensure fusion-vehicles
ensure fusion-emergency
ensure fusion-voice
ensure fusion-phone
ensure fusion-postalmap
ensure fusion-vinewood
ensure fusion-weapons
ensure fusion-appearance
ensure fusion-stores
ensure fusion-housing
ensure fusion-fuel
ensure fusion-hospital
ensure fusion-jail
ensure fusion-weather

## Your content: QBCore scripts, vehicles, EUP, maps
# Screenshots for other scripts (CCTV, evidence, MDTs). Must start before the scripts in [qb] / [addons].
ensure screenshot-basic
ensure [qb]
ensure [addons]

# Scripts set to "Start with the server" in F10 > Script Configs (Fusion writes this file, in the right
# start order). Keep this line LAST.
exec resources/[fusion]/fusion-core/permissions/startup.cfg
